table v_recording_overview
	lineageTag: b25d4c54-011d-4c23-b9da-e612b7068045

	measure Recordings =
			
			COUNTROWS('v_recording_overview')
		formatString: 0
		lineageTag: 4269eaae-8261-4210-b89c-4f23b25969c7

	measure Genres =
			
			DISTINCTCOUNTNOBLANK('v_recording_overview'[genre])
		formatString: 0
		lineageTag: 5bfeccd7-2bb5-4555-ba17-38ffb9005dc7

	measure 'Average duration, min' =
			
			DIVIDE(
			    AVERAGE('v_recording_overview'[duration_seconds]),
			    60
			)
		formatString: 0.00
		lineageTag: 7375dae2-4920-4f13-91dd-b7a7fc6f5534

	measure 'Average genre confidence' =
			
			AVERAGE('v_recording_overview'[genre_probability])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9ca2042d-4dd8-490f-a416-61def291f604

	measure 'Danceable share' =
			
			DIVIDE(
			    CALCULATE(
			        [Recordings],
			        'v_recording_overview'[danceability] = "danceable"
			    ),
			    [Recordings]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 7b033a3f-762d-42eb-8357-f3f61083ebed

	measure 'Happy share' =
			
			DIVIDE(
			    CALCULATE(
			        [Recordings],
			        'v_recording_overview'[mood_happy] = "happy"
			    ),
			    [Recordings]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a262e488-3c12-462d-90e3-bab063ec0d3d

	measure 'Relaxed share' =
			
			DIVIDE(
			    CALCULATE(
			        [Recordings],
			        'v_recording_overview'[mood_relaxed] = "relaxed"
			    ),
			    [Recordings]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f483a2ed-e5ac-4c24-aa0b-7dd813ab6839

	measure 'Aggressive share' =
			
			DIVIDE(
			    CALCULATE(
			        [Recordings],
			        'v_recording_overview'[mood_aggressive] = "aggressive"
			    ),
			    [Recordings]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 5a037bb4-1604-48cb-b442-db2d67d66759

