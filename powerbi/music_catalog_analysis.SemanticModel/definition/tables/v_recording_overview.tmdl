	column Decade = ```
			
			VAR YearValue = 'v_recording_overview'[release_year]
			RETURN
			    IF(
			        YearValue >= 1900 && YearValue <= 2026,
			        INT(YearValue / 10) * 10,
			        BLANK()
			    )
			
			```
		formatString: 0
		lineageTag: 80a0b7e5-3b4b-4ec7-9c2c-1060e4d9a80c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition v_recording_overview = m
		mode: import
		source =
				let
				    Источник = ClickHouse.Database("localhost", 8123, "music", []),
				    music_Database = Источник{[Name="music",Kind="Database"]}[Data],
				    v_recording_overview_Table = music_Database{[Name="v_recording_overview",Kind="Table"]}[Data]
				in
				    v_recording_overview_Table

	annotation PBI_ResultType = Table

